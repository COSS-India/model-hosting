name: "nmt"
backend: "python"
max_batch_size: 0

# dims [-1, 1] accepts KServe input shape [1, 1] from inference clients
input [
  { name: "INPUT_TEXT",         data_type: TYPE_STRING, dims: [ -1, 1 ] },
  { name: "INPUT_LANGUAGE_ID",  data_type: TYPE_STRING, dims: [ -1, 1 ] },
  { name: "OUTPUT_LANGUAGE_ID", data_type: TYPE_STRING, dims: [ -1, 1 ] }
]

output [
  { name: "OUTPUT_TEXT", data_type: TYPE_STRING, dims: [ -1, 1 ] }
]

instance_group [ { count: 1, kind: KIND_CPU } ]
